{
  "name": "rovyl",
  "private": true,
  "version": "1.7.0",
  "main": "backend/electron-main.js",
  "author": "HenryCa",
  "description": "Rovyl radial launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/arshit09/rovyl.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/verify-radial-windowing.mjs && node scripts/verify-renderer-budget.mjs && node scripts/generate-win-icon.mjs && node scripts/generate-appx-assets.mjs",
    "electron": "node scripts/launch-electron.js",
    "start": "node scripts/start-local-runtime.cjs",
    "start:runtime": "node scripts/dev-runtime.cjs",
    "dist": "npm run build && node scripts/run-electron-builder.mjs",
    "test:win32-launch": "node --test backend/win32-launch.test.cjs",
    "test:persistence-shape": "node scripts/persistence-normalize-smoke.mjs",
    "test:icon-map": "node scripts/icon-map-smoke.mjs",
    "test:launch-failure": "node scripts/launch-failure-smoke.mjs",
    "test:launch-result": "node scripts/launch-result-smoke.mjs",
    "test:start-app-launch": "node scripts/start-app-launch-smoke.mjs",
    "test:tray-menu": "node scripts/tray-menu-smoke.mjs",
    "test:radial-filter": "node scripts/radial-filter-smoke.mjs",
    "test:backdrop-dim": "node scripts/backdrop-dim-smoke.mjs",
    "test:icon-store": "node scripts/icon-store-smoke.mjs",
    "test:persistence-mirror": "node scripts/persistence-mirror-smoke.mjs",
    "test:foreground-snapshot": "node scripts/foreground-snapshot-smoke.mjs",
    "test:fullscreen-bounds": "node scripts/fullscreen-bounds-smoke.mjs",
    "test:page-title": "node scripts/page-title-smoke.mjs",
    "test:trigger-gesture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/trigger-gesture-smoke.ps1",
    "icons:tray": "node scripts/generate-tray-icons.mjs",
    "verify:radial-windowing": "node scripts/verify-radial-windowing.mjs",
    "verify:renderer-budget": "node scripts/verify-renderer-budget.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "dist:store": "npm run build && node scripts/run-electron-builder.mjs --win appx --publish never"
  },
  "_comment_dependencies": "Runtime only. electron-builder bundles the whole production closure into app.asar, so anything the main process does not require() belongs in devDependencies — Vite compiles the renderer's imports into dist/ and the packages themselves never ship.",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-global-key-listener": "^0.1.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "_comment_overrides": "tar<=7.5.20 carries the tree's only critical advisory (hardlink path traversal) and reaches app.asar through app-builder-lib. Its one call site there packs tar.gz/xz/bz2 targets, which this project does not build — build.win.target is nsis. glob and rimraf are deliberately NOT overridden: glob>=9 makes @electron/asar's promisified crawl hang forever, and rimraf>=4 throws on load inside cacache.",
  "overrides": {
    "tar": "^7.5.22"
  },
  "build": {
    "appId": "com.henry.rovyl",
    "productName": "Rovyl",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "backend/**/*",
      "resources/bin/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/*.ps1",
      "resources/bin/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "build-out"
    },
    "publish": {
      "provider": "github",
      "owner": "arshit09",
      "repo": "rovyl",
      "releaseType": "release"
    },
    "afterPack": "./scripts/after-pack-win-icon.cjs",
    "afterAllArtifactBuild": "./scripts/after-all-artifact-win-icon.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "uninstallDisplayName": "Rovyl",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "guid": "5e135f2a-7b3b-4e12-8c14-998822334455",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "nsis/installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "appx": {
      "identityName": "HenryCa.Rovyl",
      "publisher": "CN=B2313BE4-E4A4-4805-A379-905ED98AD53F",
      "publisherDisplayName": "HenryCa",
      "applicationId": "Rovyl",
      "displayName": "Rovyl",
      "backgroundColor": "#101014",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later"
}
